# Copie este arquivo para .env.local e preencha os valores. Veja o README para instruções
# detalhadas de como obter cada credencial.

# Chave Pix do casal (CPF/CNPJ, e-mail, telefone ou chave aleatória)
PIX_KEY=

# Opcionais: nome e cidade do recebedor exibidos no QR code Pix
PIX_MERCHANT_NAME="JESSICA E WILLIAN"
PIX_MERCHANT_CITY="BENTO GONCALVES"

# Credenciais da conta de serviço do Google usada para gravar no Google Sheets
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SHEET_ID=
